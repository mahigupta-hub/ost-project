# Free key: https://aistudio.google.com/apikey   (without a key the engine runs offline with templates)
GEMINI_API_KEY=
SB_LLM_MODEL=gemini-2.5-flash
# tfidf (offline, default) | gemini (Gemini embeddings, better for Hindi/regional) | chroma (local models)
SB_VECTOR_BACKEND=tfidf
SB_GEMINI_EMBED_MODEL=gemini-embedding-001
